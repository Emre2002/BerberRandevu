rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn()
        && request.auth.token.keys().hasAny(['superAdmin'])
        && request.auth.token.superAdmin == true;
    }

    function validText(fieldName, maxLength) {
      return request.resource.data[fieldName] is string
        && request.resource.data[fieldName].size() <= maxLength;
    }

    function membershipPath() {
      return /databases/$(database)/documents/businessMemberships/$(request.auth.uid);
    }

    function membershipExists() {
      return isSignedIn() && exists(membershipPath());
    }

    function membershipData() {
      return get(membershipPath()).data;
    }

    function hasActiveOwnerMembership() {
      return membershipExists()
        && membershipData().uid == request.auth.uid
        && membershipData().role == 'owner'
        && membershipData().status == 'active'
        && membershipData().businessId is string
        && membershipData().businessId.size() > 0;
    }

    function ownerBusinessId() {
      return membershipData().businessId;
    }

    function ownsBusiness(businessId) {
      return hasActiveOwnerMembership() && ownerBusinessId() == businessId;
    }

    function berberOwnerSafeUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['selectedServices', 'openHour', 'closeHour'])
        && (!request.resource.data.keys().hasAny(['selectedServices'])
          || (request.resource.data.selectedServices is list
            && request.resource.data.selectedServices.size() <= 30))
        && (!request.resource.data.keys().hasAny(['openHour'])
          || (validText('openHour', 5)
            && request.resource.data.openHour.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')))
        && (!request.resource.data.keys().hasAny(['closeHour'])
          || (validText('closeHour', 5)
            && request.resource.data.closeHour.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')));
    }

    function validDemoRequest() {
      return request.resource.data.keys().hasAll([
          'adSoyad', 'telefon', 'email', 'dukkanAdi', 'mesaj', 'durum', 'olusturmaTarihi'
        ])
        && request.resource.data.keys().hasOnly([
          'adSoyad', 'telefon', 'email', 'dukkanAdi', 'mesaj', 'durum', 'olusturmaTarihi'
        ])
        && validText('adSoyad', 120) && request.resource.data.adSoyad.size() > 0
        && validText('telefon', 32) && request.resource.data.telefon.size() > 0
        && validText('email', 254) && request.resource.data.email.size() > 0
        && validText('dukkanAdi', 120) && request.resource.data.dukkanAdi.size() > 0
        && validText('mesaj', 1000)
        && request.resource.data.durum == 'pasif'
        && request.resource.data.olusturmaTarihi == request.time;
    }

    function validPendingBarber() {
      return request.resource.data.keys().hasAll([
          'ownerName', 'phone', 'email', 'shopName', 'message', 'city', 'district',
          'address', 'mapsLink', 'openingHour', 'closingHour', 'packageType',
          'status', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'ownerName', 'phone', 'email', 'shopName', 'message', 'city', 'district',
          'address', 'mapsLink', 'openingHour', 'closingHour', 'packageType',
          'status', 'createdAt'
        ])
        && validText('ownerName', 120) && request.resource.data.ownerName.size() > 0
        && validText('phone', 32) && request.resource.data.phone.size() > 0
        && validText('email', 254) && request.resource.data.email.size() > 0
        && validText('shopName', 120) && request.resource.data.shopName.size() > 0
        && validText('message', 1000)
        && validText('city', 120) && request.resource.data.city.size() > 0
        && validText('district', 120) && request.resource.data.district.size() > 0
        && validText('address', 300) && request.resource.data.address.size() > 0
        && validText('mapsLink', 500)
        && validText('openingHour', 5)
        && request.resource.data.openingHour.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && validText('closingHour', 5)
        && request.resource.data.closingHour.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && request.resource.data.packageType in ['monthly', 'quarterly', 'yearly', 'demo']
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
    }

    function ownerPublicMirrorUpdate(businessId) {
      let privateBusiness = get(/databases/$(database)/documents/berberler/$(businessId)).data;
      let changes = request.resource.data.diff(resource.data).affectedKeys();
      return ownsBusiness(businessId)
        && changes.hasOnly(['selectedServices', 'openHour', 'closeHour', 'updatedAt'])
        && request.resource.data.slug == businessId
        && (!changes.hasAny(['selectedServices'])
          || request.resource.data.selectedServices == privateBusiness.selectedServices)
        && (!changes.hasAny(['openHour'])
          || request.resource.data.openHour == privateBusiness.openHour)
        && (!changes.hasAny(['closeHour'])
          || request.resource.data.closeHour == privateBusiness.closeHour)
        && (!changes.hasAny(['updatedAt'])
          || request.resource.data.updatedAt == request.time);
    }

    function tenantFieldMatches(fieldName, businessId) {
      return resource.data[fieldName] == businessId;
    }

    function tenantFieldMatchesOnCreate(fieldName, businessId) {
      return request.resource.data[fieldName] == businessId;
    }

    match /businessMemberships/{membershipUid} {
      allow get: if isSignedIn()
        && request.auth.uid == membershipUid
        && resource.data.uid == request.auth.uid;
      allow list, create, update, delete: if false;
    }

    match /berberler/{businessId} {
      allow get: if ownsBusiness(businessId) || isSuperAdmin();
      allow list, create, delete: if isSuperAdmin();
      allow update: if isSuperAdmin() || (ownsBusiness(businessId) && berberOwnerSafeUpdate());

      match /blockedSlots/{slotId} {
        allow get, list: if true;
        allow create, update: if ownsBusiness(businessId)
          && request.resource.data.keys().hasAll(['date', 'time'])
          && request.resource.data.keys().hasOnly(['date', 'time'])
          && validText('date', 10) && validText('time', 5);
        allow delete: if ownsBusiness(businessId);
      }

      match /appointments/{legacyDate} {
        allow get, list: if ownsBusiness(businessId);
        allow create, update, delete: if false;
      }
    }

    match /publicBarbers/{businessId} {
      allow get: if true;
      allow list, create, delete: if isSuperAdmin();
      allow update: if isSuperAdmin() || ownerPublicMirrorUpdate(businessId);
    }

    match /appointments/{appointmentId} {
      allow get: if hasActiveOwnerMembership()
        && tenantFieldMatches('barberId', ownerBusinessId());
      allow list: if hasActiveOwnerMembership()
        && resource.data.barberId == ownerBusinessId();
      allow create, update, delete: if false;
    }

    match /customers/{customerId} {
      allow get: if hasActiveOwnerMembership()
        && tenantFieldMatches('barberSlug', ownerBusinessId());
      allow list: if hasActiveOwnerMembership()
        && resource.data.barberSlug == ownerBusinessId();
      allow create: if hasActiveOwnerMembership()
        && tenantFieldMatchesOnCreate('barberSlug', ownerBusinessId());
      allow update: if hasActiveOwnerMembership()
        && tenantFieldMatches('barberSlug', ownerBusinessId())
        && tenantFieldMatchesOnCreate('barberSlug', ownerBusinessId());
      allow delete: if hasActiveOwnerMembership()
        && tenantFieldMatches('barberSlug', ownerBusinessId());
    }

    match /notifications/{notificationId} {
      allow get, list: if hasActiveOwnerMembership()
        && resource.data.barberSlug == ownerBusinessId();
      allow create, update, delete: if false;
    }

    match /campaigns/{campaignId} {
      allow get: if hasActiveOwnerMembership()
        && resource.data.barberSlug == ownerBusinessId();
      allow list: if hasActiveOwnerMembership()
        && resource.data.barberSlug == ownerBusinessId();
      allow create: if hasActiveOwnerMembership()
        && request.resource.data.barberSlug == ownerBusinessId();
      allow update, delete: if false;
    }

    match /deletedAppointments/{archiveId} {
      allow get: if hasActiveOwnerMembership()
        && resource.data.barberSlug == ownerBusinessId();
      allow list: if hasActiveOwnerMembership()
        && resource.data.barberSlug == ownerBusinessId();
      allow create, update, delete: if false;
    }

    match /demo_talepleri/{requestId} {
      allow create: if validDemoRequest();
      allow get, list, update, delete: if isSuperAdmin();
    }

    match /pendingBarbers/{pendingId} {
      allow create: if validPendingBarber();
      allow get, list, update, delete: if isSuperAdmin();
    }

    match /activationCodes/{codeId} {
      allow read, write: if false;
    }

    match /payments/{paymentId} {
      allow read, write: if false;
    }

    match /rateLimits/{docId} {
      allow read, write: if false;
    }

    match /appointmentAttempts/{docId} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
